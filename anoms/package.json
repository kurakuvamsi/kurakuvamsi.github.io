{
  "name": "anoms-angular",
  "version": "1.0.0",
  "description": "ANOMS website converted from the supplied HTML mockup",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "serve:dist": "http-server dist/anoms-angular/browser -p 8080 -c-1 -o"
  },
  "dependencies": {
    "@angular/common": "21.2.22",
    "@angular/compiler": "21.2.22",
    "@angular/core": "21.2.22",
    "@angular/platform-browser": "21.2.22",
    "@angular/router": "^21.2.22",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.16.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.22",
    "@angular/cli": "21.2.22",
    "@angular/compiler-cli": "21.2.22",
    "http-server": "^14.1.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || ^24.0.0"
  }
}
